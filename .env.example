# 爆款视频复刻智能体 - 环境变量配置示例
# 复制此文件为 .env 并修改配置

# ==================== 基础配置 ====================
# 应用名称
APP_NAME="爆款视频复刻智能体"
APP_VERSION="1.0.0"

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL="INFO"

# 时区
TZ="Asia/Shanghai"

# ==================== 路径配置 ====================
# 数据目录
DATA_DIR="./data"
# 模型目录
MODELS_DIR="./models"
# 日志目录
LOGS_DIR="./logs"
# 临时目录
TEMP_DIR="./temp"

# ==================== API配置 ====================
# API监听地址
API_HOST="0.0.0.0"
API_PORT=8000

# 管理面板端口
ADMIN_PORT=8080

# API密钥（用于认证）
API_KEY="your-api-key-here"

# 管理员令牌（多个用逗号分隔）
ADMIN_TOKENS="admin123,superadmin"

# 跨域设置
CORS_ORIGINS="*"
CORS_CREDENTIALS="true"

# ==================== 模型配置 ====================
# 人脸检测模型路径
FACE_DETECTION_MODEL="${MODELS_DIR}/face_detection/buffalo_l"
# 人脸替换模型路径
FACE_SWAP_MODEL="${MODELS_DIR}/face_swap/inswapper_128.onnx"
# 文本模型名称
TEXT_MODEL="Qwen/Qwen2.5-1.5B-Instruct"

# GPU加速 (true/false)
USE_GPU="true"
# CUDA设备ID
CUDA_DEVICE="0"

# ==================== 视频处理配置 ====================
# 目标分辨率 (宽x高)
TARGET_RESOLUTION="1080x1920"
# 目标帧率
TARGET_FPS=30
# 最大视频时长 (秒)
MAX_VIDEO_DURATION=300
# 视频质量: low, medium, high, veryhigh
VIDEO_QUALITY="high"

# ==================== 下载配置 ====================
# 下载超时 (秒)
DOWNLOAD_TIMEOUT=30
# 最大重试次数
DOWNLOAD_MAX_RETRIES=3
# 用户代理
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"

# ==================== 文案重写配置 ====================
# 默认风格: humorous, formal, casual, persuasive, concise, creative
DEFAULT_REWRITE_STYLE="casual"
# 最大文本长度
MAX_TEXT_LENGTH=500
# 温度参数
TEXT_TEMPERATURE=0.7

# ==================== 人脸替换配置 ====================
# 相似度阈值
FACE_SIMILARITY_THRESHOLD=0.5
# 融合比例
FACE_BLEND_RATIO=0.8
# 最大人脸数
MAX_FACES=5

# ==================== 外部API配置 ====================
# OpenAI API (可选)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-3.5-turbo"

# 通义千问API (可选)
QWEN_API_KEY=""
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
QWEN_MODEL="qwen-turbo"

# ChatGLM API (可选，本地部署)
CHATGLM_API_KEY=""
CHATGLM_BASE_URL="http://localhost:8000/v1"
CHATGLM_MODEL="chatglm3-6b"

# ==================== 存储配置 ====================
# 最大存储空间 (MB)
MAX_STORAGE_SIZE=10240  # 10GB
# 自动清理旧文件 (天)
CLEANUP_OLD_FILES_DAYS=7
# 保留临时文件 (true/false)
KEEP_TEMP_FILES="false"

# ==================== 性能配置 ====================
# 并行任务数
MAX_WORKERS=4
# 批处理大小
BATCH_SIZE=1
# 内存限制 (MB)
MEMORY_LIMIT=4096

# ==================== 安全配置 ====================
# 启用认证
ENABLE_AUTH="false"
# 允许的文件扩展名
ALLOWED_EXTENSIONS="jpg,jpeg,png,bmp,mp4,avi,mov,mkv"
# 最大文件大小 (MB)
MAX_FILE_SIZE=100
# 请求频率限制 (次/分钟)
RATE_LIMIT=60

# ==================== 监控配置 ====================
# 启用监控
ENABLE_MONITORING="true"
# 监控间隔 (秒)
MONITOR_INTERVAL=5
# 保留监控数据 (小时)
MONITOR_RETENTION_HOURS=24

# ==================== 通知配置 ====================
# 启用邮件通知
ENABLE_EMAIL_NOTIFICATION="false"
# SMTP服务器
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
EMAIL_FROM=""
EMAIL_TO=""

# ==================== 开发配置 ====================
# 调试模式
DEBUG="false"
# 热重载
HOT_RELOAD="false"
# 测试模式
TEST_MODE="false"

# ==================== Docker配置 ====================
# Docker镜像名称
DOCKER_IMAGE="openclaw/video-replication-agent"
# Docker标签
DOCKER_TAG="latest"
# Docker网络
DOCKER_NETWORK="video-replication-network"

# ==================== 数据库配置 (可选) ====================
# 数据库类型: sqlite, postgres, mysql
DATABASE_TYPE="sqlite"
# SQLite数据库路径
SQLITE_DB_PATH="./data/app.db"
# PostgreSQL连接
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="video_replication"
POSTGRES_USER="video_user"
POSTGRES_PASSWORD="video_password"

# ==================== Redis配置 (可选) ====================
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# ==================== 备份配置 ====================
# 启用自动备份
ENABLE_AUTO_BACKUP="false"
# 备份间隔 (小时)
BACKUP_INTERVAL=24
# 备份保留天数
BACKUP_RETENTION_DAYS=7
# 备份目录
BACKUP_DIR="./backups"

# ==================== 更新配置 ====================
# 启用自动更新
ENABLE_AUTO_UPDATE="false"
# 更新检查间隔 (小时)
UPDATE_CHECK_INTERVAL=24
# GitHub仓库
GITHUB_REPO="openclaw/video-replication-agent"